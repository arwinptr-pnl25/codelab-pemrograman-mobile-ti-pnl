<script>
  function initLearningProgress() {
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>('.lesson-card[data-lesson-slug]')
    );

    const checklistPerModule = 4;
    const totalModules = cards.length;
    const totalChecklists = totalModules * checklistPerModule;

    let completedModules = 0;
    let completedChecklists = 0;

    cards.forEach((card) => {
      const slug = card.dataset.lessonSlug;
      if (!slug) return;

      const statusElement = card.querySelector<HTMLElement>(
        '.lesson-progress-status'
      );
      const countElement = card.querySelector<HTMLElement>(
        '.lesson-progress-count'
      );
      const fillElement = card.querySelector<HTMLElement>(
        '.lesson-progress-fill'
      );

      let savedState: Record<string, boolean> = {};

      try {
        const saved = localStorage.getItem(
          `codelab-trkj-checklist-${slug}`
        );

        savedState = saved ? JSON.parse(saved) : {};
      } catch {
        savedState = {};
      }

      const completed = Object.values(savedState).filter(
        (value) => value === true
      ).length;

      // Batasi jumlah checklist agar tidak melebihi 4 per modul.
      const safeCompleted = Math.min(completed, checklistPerModule);
      const percentage = (safeCompleted / checklistPerModule) * 100;

      completedChecklists += safeCompleted;

      if (safeCompleted === checklistPerModule) {
        completedModules++;
        card.dataset.progressState = 'completed';

        if (statusElement) {
          statusElement.textContent = 'Selesai';
        }
      } else if (safeCompleted > 0) {
        card.dataset.progressState = 'in-progress';

        if (statusElement) {
          statusElement.textContent = 'Sedang dipelajari';
        }
      } else {
        card.dataset.progressState = 'not-started';

        if (statusElement) {
          statusElement.textContent = 'Belum dimulai';
        }
      }

      if (countElement) {
        countElement.textContent =
          `${safeCompleted}/${checklistPerModule}`;
      }

      if (fillElement) {
        fillElement.style.width = `${percentage}%`;
      }
    });

    const overallPercentage =
      totalChecklists > 0
        ? Math.round((completedChecklists / totalChecklists) * 100)
        : 0;

    const percentageElement = document.querySelector<HTMLElement>(
      '#overall-percentage'
    );
    const overallFill = document.querySelector<HTMLElement>(
      '#overall-progress-fill'
    );
    const overallText = document.querySelector<HTMLElement>(
      '#overall-progress-text'
    );
    const modulesElement = document.querySelector<HTMLElement>(
      '#completed-modules'
    );
    const checklistsElement = document.querySelector<HTMLElement>(
      '#completed-checklists'
    );
    const statusElement = document.querySelector<HTMLElement>(
      '#progress-status'
    );

    if (percentageElement) {
      percentageElement.textContent = `${overallPercentage}%`;
    }

    if (overallFill) {
      overallFill.style.width = `${overallPercentage}%`;
    }

    if (overallText) {
      overallText.textContent =
        `${completedChecklists} dari ${totalChecklists} checklist telah diselesaikan.`;
    }

    if (modulesElement) {
      modulesElement.textContent = String(completedModules);
    }

    if (checklistsElement) {
      checklistsElement.textContent = String(completedChecklists);
    }

    if (statusElement) {
      if (completedModules === totalModules && totalModules > 0) {
        statusElement.textContent = 'Semua modul selesai';
      } else if (completedChecklists > 0) {
        statusElement.textContent = 'Sedang belajar';
      } else {
        statusElement.textContent = 'Belum dimulai';
      }
    }
  }

  initLearningProgress();
</script>

