<script>
  // Tombol salin untuk setiap blok kode Markdown.
  
  // Tombol salin untuk setiap blok kode Markdown.
  document.querySelectorAll('.markdown-content pre').forEach((pre) => {
    if (pre.parentElement?.classList.contains('code-card')) return;

    const wrapper = document.createElement('div');
    wrapper.className = 'code-card';

    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    const header = document.createElement('div');
    header.className = 'code-header';

    const code = pre.querySelector('code');
    const language =
      code?.className.match(/language-([\w-]+)/)?.[1] ?? 'CODE';

    const languageLabel = document.createElement('span');
    languageLabel.className = 'code-language';
    languageLabel.textContent = language.toUpperCase();

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-button';
    button.innerHTML = `
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="8" y="8" width="12" height="12" rx="2"></rect>
        <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"></path>
      </svg>
      <span>Salin kode</span>
    `;

    const label = button.querySelector('span');

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(
          code?.textContent ?? pre.textContent ?? ''
        );

        if (label) label.textContent = 'Tersalin!';
        button.classList.add('is-copied');

        window.setTimeout(() => {
          if (label) label.textContent = 'Salin kode';
          button.classList.remove('is-copied');
        }, 1800);
      } catch {
        if (label) label.textContent = 'Gagal menyalin';
      }
    });

    header.append(languageLabel, button);
    wrapper.insertBefore(header, pre);
  });


  // Progress checklist di halaman saat ini.
  const checkboxes = Array.from(
    document.querySelectorAll<HTMLInputElement>('.check-item input')
  );
  const count = document.querySelector('#progress-count');
  const fill = document.querySelector<HTMLElement>('#progress-fill');

  function updateProgress() {
    const completed = checkboxes.filter((checkbox) => checkbox.checked).length;

    if (count) count.textContent = `${completed}/${checkboxes.length}`;
    if (fill) fill.style.width = `${checkboxes.length ? completed / checkboxes.length * 100 : 0}%`;
  }

  checkboxes.forEach((checkbox) => {
    checkbox.addEventListener('change', updateProgress);
  });

  // fitur simpan checklist
  function initChecklistStorage() {
    const checklist = document.querySelector<HTMLElement>(
      '#checklist-praktikum'
    );

    if (!checklist) return;

    const slug = checklist.dataset.slug;
    if (!slug) return;

    // Kunci penyimpanan unik untuk setiap pertemuan.
    const storageKey = `codelab-trkj-checklist-${slug}`;

    const checkboxes = Array.from(
      checklist.querySelectorAll<HTMLInputElement>(
        'input[data-checklist-id]'
      )
    );

    const progressCount = document.querySelector<HTMLElement>(
      '#progress-count'
    );

    const progressBar = document.querySelector<HTMLElement>(
      '#checklist-progress-bar'
    );

    // Membaca data dari localStorage.
    function loadChecklist(): Record<string, boolean> {
      try {
        const saved = localStorage.getItem(storageKey);
        return saved ? JSON.parse(saved) : {};
      } catch {
        return {};
      }
    }

    // Memperbarui tulisan dan progress bar.
    function updateProgress() {
      const completed = checkboxes.filter(
        (checkbox) => checkbox.checked
      ).length;

      const total = checkboxes.length;
      const percentage =
        total > 0 ? (completed / total) * 100 : 0;

      if (progressCount) {
        progressCount.textContent = `${completed}/${total}`;
      }

      if (progressBar) {
        progressBar.style.width = `${percentage}%`;
      }
    }

    // Pulihkan status checklist yang tersimpan.
    const savedState = loadChecklist();

    checkboxes.forEach((checkbox) => {
      const id = checkbox.dataset.checklistId;

      checkbox.checked = id ? savedState[id] === true : false;

      checkbox.addEventListener('change', () => {
        const currentState = loadChecklist();
        const currentId = checkbox.dataset.checklistId;

        if (!currentId) return;

        currentState[currentId] = checkbox.checked;

        try {
          localStorage.setItem(
            storageKey,
            JSON.stringify(currentState)
          );
        } catch (error) {
          console.warn('Gagal menyimpan checklist:', error);
        }

        updateProgress();
      });
    });

    // Jalankan setelah semua status checkbox dipulihkan.
    updateProgress();
  }

  initChecklistStorage();
</script>

