
---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';


export async function getStaticPaths() {
  const materi = await getCollection('praktikum');

  // Urutkan materi berdasarkan nomor pertemuan.
  const materiTerurut = materi.sort(
    (a, b) => a.data.pertemuan - b.data.pertemuan
  );

  return materiTerurut.map((item, index) => ({
    params: { slug: item.id },
    props: {
      item,
      previous: materiTerurut[index - 1] ?? null,
      next: materiTerurut[index + 1] ?? null,
    },
  }));
}

const { item, previous, next } = Astro.props;
const { Content } = await render(item);
const nomor = String(item.data.pertemuan).padStart(2, '0');

